<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>الدروس</title>
  <link rel="stylesheet" href="/style.css">

  <style>
    .lesson-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      padding: 18px;
      margin-top: 14px;
      border: 1px solid rgba(255,255,255,.08);
      border-radius: 18px;
      background: rgba(15,23,42,.72);
      flex-wrap: wrap;
    }

    .lesson-row.completed {
      border-color: rgba(34,197,94,.25);
      background: rgba(34,197,94,.08);
    }

    .lesson-row.locked {
      opacity: .78;
      border-color: rgba(148,163,184,.18);
      background: rgba(15,23,42,.45);
    }

    .lesson-number {
      width: 48px;
      height: 48px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      background: rgba(99,102,241,.14);
      color: #fff;
      flex-shrink: 0;
    }

    .lesson-row.completed .lesson-number {
      background: rgba(34,197,94,.18);
      color: #bbf7d0;
    }

    .lesson-row.locked .lesson-number {
      background: rgba(148,163,184,.12);
      color: #cbd5e1;
    }

    .lesson-info {
      flex: 1;
      min-width: 220px;
    }

    .lesson-info h3 {
      margin: 0 0 6px;
      font-size: 19px;
    }

    .lesson-info p {
      margin: 0;
      color: var(--muted);
      line-height: 1.7;
    }

    .lesson-action {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 12px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 800;
      white-space: nowrap;
    }

    .status-pill.done {
      background: rgba(34,197,94,.15);
      color: #bbf7d0;
      border: 1px solid rgba(34,197,94,.22);
    }

    .status-pill.locked {
      background: rgba(148,163,184,.12);
      color: #e2e8f0;
      border: 1px solid rgba(148,163,184,.18);
    }

    .status-pill.open {
      background: rgba(99,102,241,.14);
      color: #c7d2fe;
      border: 1px solid rgba(99,102,241,.18);
    }

    .btn.disabled-btn {
      background: rgba(148,163,184,.12);
      color: #94a3b8;
      border: 1px solid rgba(148,163,184,.18);
      cursor: not-allowed;
      box-shadow: none;
    }

    .chapter-box {
      margin-bottom: 24px;
    }

    @media (max-width: 768px) {
      .lesson-row {
        align-items: flex-start;
      }

      .lesson-action {
        width: 100%;
        justify-content: flex-start;
      }

      .lesson-action .btn,
      .lesson-action button {
        width: 100%;
      }
    }
  </style>

  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#0d6efd">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="Rabie Physics">
  <link rel="apple-touch-icon" href="/icons/icon-192.png">

</head>

<body>

  <nav class="topbar">
    <a class="logo" href="/dashboard">
      <span>⚛</span>
      physics
    </a>

    <div class="nav-actions">
      <a href="/dashboard">لوحة التحكم</a>

      <form method="POST" action="/logout">
        <button class="btn ghost small">
          خروج
        </button>
      </form>
    </div>
  </nav>

  <main class="container">

    <header class="page-head">
      <div>
        <span class="eyebrow">
          المحتوى الدراسي
        </span>

        <h1>
          <%= grade === "second"
            ? "الصف الثاني الثانوي"
            : "الصف الثالث الثانوي"
          %>
        </h1>

        <p class="muted">
          أنهِ الدروس بالترتيب لفتح الدرس التالي،
          ويمكنك الرجوع لأي درس مكتمل في أي وقت.
        </p>
      </div>

      <div class="progress-circle">
        <%= progressPercent %>%
      </div>
    </header>

    <% chapters.forEach(chapter => { %>

      <section class="panel chapter-box">

        <div class="section-head">
          <div>
            <span class="eyebrow">
              فصل <%= chapter.chapterOrder || chapter.order %>
            </span>

            <h2>
              <%= chapter.title %>
            </h2>
          </div>
        </div>

        <%
          lessons
            .filter(
              lesson =>
                String(lesson.chapterId) ===
                String(chapter.id)
            )
            .forEach(lesson => {
        %>

          <article
            class="lesson-row <%= lesson.completed ? 'completed' : (!lesson.unlocked ? 'locked' : '') %>"
          >

            <div class="lesson-number">
              <% if (lesson.completed) { %>
                ✅
              <% } else if (!lesson.unlocked) { %>
                🔒
              <% } else { %>
                <%= lesson.lessonOrder || lesson.order %>
              <% } %>
            </div>

            <div class="lesson-info">
              <h3>
                <%= lesson.title %>
              </h3>

              <p>
                <%= lesson.description || "درس فيزياء" %>
              </p>
            </div>

            <div class="lesson-action">

              <% if (lesson.completed) { %>

                <span class="status-pill done">
                  ✅ مكتمل
                </span>

                <a
                  class="btn primary small"
                  href="/lesson/<%= grade %>/<%= lesson.id %>"
                >
                  مشاهدة الدرس مرة أخرى
                </a>

              <% } else if (lesson.unlocked) { %>

                <span class="status-pill open">
                  📘 متاح
                </span>

                <a
                  class="btn primary small"
                  href="/lesson/<%= grade %>/<%= lesson.id %>"
                >
                  ابدأ الدرس
                </a>

              <% } else { %>

                <span class="status-pill locked">
                  🔒 مقفول
                </span>

                <button
                  class="btn disabled-btn small"
                  type="button"
                  disabled
                >
                  يجب إنهاء الدرس السابق أولًا
                </button>

              <% } %>

            </div>

          </article>

        <% }) %>

      </section>

    <% }) %>

  </main>


  <script>
    if ("serviceWorker" in navigator) {
      window.addEventListener("load", function () {
        navigator.serviceWorker
          .register("/service-worker.js")
          .then(function (registration) {
            console.log("Service Worker registered:", registration.scope);
          })
          .catch(function (error) {
            console.error("Service Worker registration failed:", error);
          });
      });
    }
  </script>

</body>
</html>
