<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>الدروس</title><link rel="stylesheet" href="/style.css"></head><body><nav class="topbar"><a class="logo" href="/dashboard"><span>⚛</span> physics</a><div class="nav-actions"><a href="/dashboard">لوحة التحكم</a><form method="POST" action="/logout"><button class="btn ghost small">خروج</button></form></div></nav><main class="container"><header class="page-head"><div><span class="eyebrow">المحتوى الدراسي</span><h1><%= grade==="second"?"الصف الثاني الثانوي":"الصف الثالث الثانوي" %></h1><p class="muted">أنهِ الدروس بالترتيب لفتح الدرس التالي.</p></div><div class="progress-circle"><%= progressPercent %>%</div></header><% chapters.forEach(chapter=>{ %><section class="panel"><div class="section-head"><div><span class="eyebrow">فصل <%= chapter.order %></span><h2><%= chapter.title %></h2></div></div><% lessons.filter(l=>String(l.chapterId)===String(chapter.id)).forEach(lesson=>{ %><article class="lesson-row <%= lesson.completed?'completed':(!lesson.unlocked?'locked':'') %>"><div class="lesson-number"><%= lesson.order %></div><div class="lesson-info"><h3><%= lesson.title %></h3><p><%= lesson.description||'درس فيزياء' %></p></div><div class="lesson-action"><% if(lesson.completed){ %><span class="badge success">✓ مكتمل</span><% } else if(lesson.unlocked){ %><a class="btn primary small" href="/lesson/<%= grade %>/<%= lesson.id %>">ابدأ الدرس</a><% } else { %><span class="badge locked">🔒 مغلق</span><% } %></div></article><% }) %></section><% }) %></main></body></html>
