<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= lesson.title %></title><link rel="stylesheet" href="/style.css"></head><body><nav class="topbar"><a class="logo" href="/dashboard"><span>⚛</span> physics</a><a href="/grade/<%= grade %>">← العودة للدروس</a></nav><main class="lesson-layout"><section class="lesson-main"><div class="lesson-heading"><span class="eyebrow">الدرس <%= lesson.order %></span><h1><%= lesson.title %></h1><p><%= lesson.description||'' %></p></div><% if(lesson.videoUrl){ %><div class="video-card"><div class="video-placeholder"><div class="play-icon">▶</div><h3>فيديو الدرس</h3><a class="btn primary" href="<%= lesson.videoUrl %>" target="_blank">فتح الفيديو</a></div></div><% } %><section class="panel"><div class="section-head"><div><span class="eyebrow">تطبيق</span><h2>تدريبات الدرس</h2></div><span class="badge"><%= lesson.exercises.length %> سؤال</span></div><% if(!lesson.exercises.length){ %><p class="muted">لا توجد تدريبات حتى الآن.</p><% } %><% lesson.exercises.forEach(ex=>{ %><div class="exercise-card"><span class="question-number">سؤال <%= ex.order %></span><h3><%= ex.question %></h3><form method="POST" action="/lesson/<%= grade %>/<%= lesson.id %>/exercise/<%= ex.id %>/check"><input name="answer" placeholder="اكتب إجابتك هنا..." required><button class="btn secondary">تحقق من الإجابة</button></form><% if(exerciseResult&&String(exerciseResult.exerciseId)===String(ex.id)){ %><% if(exerciseResult.correct){ %><div class="alert success">✅ إجابة صحيحة، ممتاز!</div><% } else { %><div class="alert error">❌ الإجابة غير صحيحة. الصحيحة: <strong><%= exerciseResult.correctAnswer %></strong></div><% } %><% } %></div><% }) %></section><% if(success){ %><div class="alert success"><%= success %></div><% } %><form method="POST" action="/lesson/<%= grade %>/<%= lesson.id %>/complete"><button class="btn complete full">✓ أنهيت الدرس — فتح الدرس التالي</button></form></section><aside class="lesson-sidebar"><div class="panel sticky-card"><div class="big-icon">🎯</div><h3>هدف الدرس</h3><p class="muted">شاهد الشرح، حل التدريبات، ثم أنهِ الدرس.</p></div></aside></main></body></html>
