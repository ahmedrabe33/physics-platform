<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  >

  <title>Physics | تسجيل الدخول</title>

  <link
    rel="stylesheet"
    href="/style.css"
  >

  <style>

    .login-page {
      min-height: 100vh;

      display: flex;
      align-items: center;
      justify-content: center;

      padding: 30px 18px;

      position: relative;
      overflow: hidden;
    }


    .login-page::before {
      content: "";

      position: absolute;

      width: 420px;
      height: 420px;

      border-radius: 50%;

      background:
        rgba(99, 102, 241, 0.18);

      filter: blur(90px);

      top: -150px;
      right: -100px;

      pointer-events: none;
    }


    .login-page::after {
      content: "";

      position: absolute;

      width: 360px;
      height: 360px;

      border-radius: 50%;

      background:
        rgba(139, 92, 246, 0.16);

      filter: blur(90px);

      bottom: -140px;
      left: -80px;

      pointer-events: none;
    }


    .login-container {
      width: 100%;
      max-width: 460px;

      position: relative;
      z-index: 2;
    }


    .login-brand {
      text-align: center;
      margin-bottom: 28px;
    }


    .login-logo {
      width: 72px;
      height: 72px;

      margin: 0 auto 18px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 22px;

      font-size: 36px;

      background:
        linear-gradient(
          135deg,
          #6366f1,
          #8b5cf6
        );

      box-shadow:
        0 18px 45px
        rgba(99, 102, 241, 0.35);
    }


    .login-brand h1 {
      margin: 0;

      font-size: 34px;
      font-weight: 800;

      letter-spacing: 1px;
    }


    .login-brand p {
      margin: 10px 0 0;

      font-size: 15px;
      line-height: 1.8;
    }



    .teacher-info {
      margin-top: 18px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      text-align: center;
    }

    .teacher-name {
      color: #f8fafc;
      font-size: 19px;
      font-weight: 900;
      letter-spacing: .3px;
    }

    .whatsapp-button {
      min-height: 48px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 11px 18px;
      border: 1px solid rgba(37, 211, 102, .38);
      border-radius: 14px;
      background: linear-gradient(
        135deg,
        rgba(37, 211, 102, .2),
        rgba(18, 140, 126, .18)
      );
      color: #dcfce7;
      text-decoration: none;
      font-size: 15px;
      font-weight: 900;
      box-shadow: 0 12px 30px rgba(37, 211, 102, .18);
      transition: transform .2s, background .2s, box-shadow .2s;
    }

    .whatsapp-button:hover {
      transform: translateY(-2px);
      background: linear-gradient(
        135deg,
        rgba(37, 211, 102, .3),
        rgba(18, 140, 126, .26)
      );
      box-shadow: 0 16px 36px rgba(37, 211, 102, .26);
    }

    .whatsapp-button svg {
      width: 22px;
      height: 22px;
      flex-shrink: 0;
      fill: currentColor;
    }

    .login-card {
      padding: 34px;

      border-radius: 26px;

      background:
        rgba(24, 34, 53, 0.88);

      border:
        1px solid
        rgba(255,255,255,0.08);

      box-shadow:
        0 30px 70px
        rgba(0,0,0,0.38);

      backdrop-filter: blur(16px);
    }


    .login-card-header {
      text-align: center;
      margin-bottom: 28px;
    }


    .login-card-header h2 {
      margin: 0 0 8px;
      font-size: 27px;
    }


    .login-card-header p {
      margin: 0;
      font-size: 14px;
    }


    .login-form {
      display: flex;
      flex-direction: column;
      gap: 18px;
    }


    .field-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }


    .field-group label {
      font-size: 14px;
      font-weight: 700;
      color: #e2e8f0;
    }


    .field-group input {
      width: 100%;
      height: 52px;

      padding: 0 16px;

      border-radius: 14px;

      border:
        1px solid
        rgba(255,255,255,0.08);

      background:
        rgba(15,23,42,0.8);

      color: #fff;

      font-size: 15px;

      transition:
        border-color .2s,
        box-shadow .2s,
        transform .2s;
    }


    .field-group input::placeholder {
      color: #64748b;
    }


    .field-group input:focus {
      border-color: #6366f1;

      box-shadow:
        0 0 0 4px
        rgba(99,102,241,0.12);

      transform: translateY(-1px);
    }


    .password-wrap {
      position: relative;
    }


    .password-wrap input {
      padding-left: 54px;
    }


    .password-toggle {
      position: absolute;

      left: 10px;
      top: 50%;

      transform: translateY(-50%);

      border: 0;

      background: transparent;

      color: #94a3b8;

      font-size: 18px;

      cursor: pointer;

      width: 36px;
      height: 36px;

      padding: 0;
    }


    .login-button {
      width: 100%;
      height: 54px;

      margin-top: 4px;

      border: none;
      border-radius: 15px;

      cursor: pointer;

      font-size: 16px;
      font-weight: 800;

      color: white;

      background:
        linear-gradient(
          135deg,
          #6366f1,
          #8b5cf6
        );

      box-shadow:
        0 14px 35px
        rgba(99,102,241,0.35);

      transition:
        transform .2s,
        box-shadow .2s;
    }


    .login-button:hover {
      transform: translateY(-2px);

      box-shadow:
        0 18px 42px
        rgba(99,102,241,0.45);
    }


    .payment-section {
      margin-top: 22px;
      padding-top: 22px;

      border-top:
        1px solid
        rgba(255,255,255,0.08);

      text-align: center;
    }


    .payment-title {
      margin: 0 0 6px;

      color: #f8fafc;

      font-size: 15px;
      font-weight: 800;
    }


    .payment-text {
      margin: 0 0 14px;

      color: #94a3b8;

      font-size: 13px;
      line-height: 1.7;
    }


    .payment-button {
      width: 100%;
      min-height: 58px;

      display: flex;
      align-items: center;
      justify-content: center;

      gap: 11px;

      padding: 13px 18px;

      border-radius: 16px;

      border:
        1px solid
        rgba(34,197,94,0.4);

      background:
        linear-gradient(
          135deg,
          #16a34a,
          #059669
        );

      color: white;

      font-size: 16px;
      font-weight: 800;

      box-shadow:
        0 14px 35px
        rgba(34,197,94,0.24);

      transition:
        transform .2s,
        box-shadow .2s,
        filter .2s;
    }


    .payment-button:hover {
      transform: translateY(-2px);

      box-shadow:
        0 18px 42px
        rgba(34,197,94,0.34);

      filter: brightness(1.08);
    }


    .payment-button-icon {
      width: 38px;
      height: 38px;

      display: flex;
      align-items: center;
      justify-content: center;

      flex-shrink: 0;

      border-radius: 12px;

      background:
        rgba(255,255,255,0.17);

      font-size: 20px;
    }


    .login-links {
      margin-top: 22px;

      display: flex;
      justify-content: center;
      align-items: center;
      flex-wrap: wrap;

      gap: 8px;

      font-size: 14px;
    }


    .login-links a {
      color: #a5b4fc;
      font-weight: 700;
    }


    .login-links a:hover {
      color: #c4b5fd;
    }


    .login-error {
      margin-bottom: 20px;

      padding: 13px 15px;

      border-radius: 12px;

      background:
        rgba(239,68,68,0.12);

      border:
        1px solid
        rgba(239,68,68,0.25);

      color: #fecaca;

      text-align: center;

      font-size: 14px;
    }


    .login-footer {
      margin-top: 22px;

      text-align: center;

      color: #64748b;

      font-size: 12px;
    }


    @media (max-width: 600px) {

      .login-page {
        padding: 24px 15px;
        align-items: flex-start;
      }


      .login-container {
        margin-top: 18px;
      }


      .login-card {
        padding: 26px 20px;
        border-radius: 22px;
      }


      .login-brand {
        margin-bottom: 22px;
      }


      .login-logo {
        width: 64px;
        height: 64px;

        border-radius: 19px;

        font-size: 31px;
      }


      .login-brand h1 {
        font-size: 29px;
      }


      .login-brand p {
        font-size: 14px;
      }


      .login-card-header {
        margin-bottom: 23px;
      }


      .login-card-header h2 {
        font-size: 23px;
      }


      .payment-button {
        font-size: 15px;
        padding: 12px;
      }


      .login-links {
        line-height: 1.8;
      }

    }

  </style>


  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#0d6efd">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="Rabie Physics">
  <link rel="apple-touch-icon" href="/icons/icon-192.png">

</head>


<body>


<main class="login-page">


  <div class="login-container">


    <section class="login-brand">

      <div class="login-logo">
        ⚛
      </div>

      <h1>
        Physics
      </h1>

      <p>
        منصتك لتنظيم دراسة الفيزياء،
        متابعة الدروس،
        وحل التدريبات خطوة بخطوة.
      </p>

      <div class="teacher-info">

        <div class="teacher-name">
          Eng. Ahmed Rabie
        </div>

        <a
          class="whatsapp-button"
          href="https://wa.me/201501600960?text=%D8%A7%D9%84%D8%B3%D9%84%D8%A7%D9%85%20%D8%B9%D9%84%D9%8A%D9%83%D9%85%20%D9%8A%D8%A7%20%D9%85%D8%B3%D8%AA%D8%B1%20%D8%A3%D8%AD%D9%85%D8%AF"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="التواصل مع مستر أحمد عبر واتساب"
        >
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <path d="M19.11 17.21c-.27-.14-1.58-.78-1.82-.87-.24-.09-.42-.14-.6.14-.18.27-.69.87-.84 1.05-.16.18-.31.2-.58.07-.27-.14-1.14-.42-2.18-1.34-.8-.72-1.35-1.61-1.5-1.88-.16-.27-.02-.42.12-.55.12-.12.27-.31.4-.47.14-.16.18-.27.27-.45.09-.18.05-.34-.02-.47-.07-.14-.6-1.45-.82-1.98-.22-.52-.44-.45-.6-.46h-.51c-.18 0-.47.07-.71.34-.24.27-.93.91-.93 2.22 0 1.31.96 2.58 1.09 2.76.14.18 1.88 2.87 4.56 4.02.64.27 1.13.44 1.52.56.64.2 1.22.17 1.68.1.51-.08 1.58-.64 1.8-1.26.22-.62.22-1.15.16-1.26-.07-.12-.25-.18-.52-.31z"/>
            <path d="M16.05 3C8.88 3 3.07 8.81 3.07 15.98c0 2.29.6 4.53 1.73 6.5L3 29l6.7-1.76a12.9 12.9 0 0 0 6.35 1.62h.01c7.16 0 12.97-5.82 12.97-12.98S23.22 3 16.05 3zm0 23.67h-.01a10.7 10.7 0 0 1-5.45-1.49l-.39-.23-3.98 1.04 1.06-3.88-.25-.4a10.72 10.72 0 1 1 9.02 4.96z"/>
          </svg>

          <span>
            تواصل معي على واتساب
          </span>
        </a>

      </div>


    </section>


    <section class="login-card">


      <div class="login-card-header">

        <h2>
          جاهز نكمل؟ 👋
        </h2>

        <p>
          سجل دخولك وكمّل من آخر درس وصلت له.
        </p>

      </div>


      <% if(error){ %>

        <div class="login-error">
          <%= error %>
        </div>

      <% } %>


      <form
        class="login-form"
        method="POST"
        action="/login"
      >


        <div class="field-group">

          <label for="username">
            اسم المستخدم
          </label>

          <input
            id="username"
            name="username"
            type="text"
            placeholder="اكتب اسم المستخدم"
            autocomplete="username"
            required
          >

        </div>


        <div class="field-group">

          <label for="password">
            كلمة المرور
          </label>

          <div class="password-wrap">

            <input
              id="password"
              name="password"
              type="password"
              placeholder="اكتب كلمة المرور"
              autocomplete="current-password"
              required
            >

            <button
              class="password-toggle"
              type="button"
              onclick="togglePassword()"
              aria-label="إظهار أو إخفاء كلمة المرور"
            >
              👁
            </button>

          </div>

        </div>


        <button
          class="login-button"
          type="submit"
        >
          دخول إلى المنصة
        </button>

      </form>


      <div class="payment-section">

        <p class="payment-title">
          طالب جديد؟
        </p>

        <p class="payment-text">
          أنشئ حسابك وارفع صورة إثبات الدفع ليتم مراجعة طلبك.
        </p>

        <a
          class="payment-button"
          href="/signup"
        >

          <span class="payment-button-icon">
            💳
          </span>

          <span>
            إنشاء حساب ورفع إثبات الدفع
          </span>

        </a>

      </div>


      <div class="login-links">

        <a href="/forgot-password">
          نسيت كلمة المرور؟
        </a>

        <span>•</span>

        <a href="/signup">
          إنشاء حساب جديد
        </a>

      </div>


    </section>


    <div class="login-footer">
      ⚛ Physics Learning Platform
    </div>


  </div>


</main>


<script>

  function togglePassword() {

    const input =
      document.getElementById("password");

    input.type =
      input.type === "password"
        ? "text"
        : "password";

  }

</script>



  <script>
    if ("serviceWorker" in navigator) {
      window.addEventListener("load", function () {
        navigator.serviceWorker
          .register("/service-worker.js")
          .then(function (registration) {
            console.log("Service Worker registered:", registration.scope);
          })
          .catch(function (error) {
            console.error("Service Worker registration failed:", error);
          });
      });
    }
  </script>

</body>

</html>
