<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  >

  <title>لوحة الطالب</title>

  <link
    rel="stylesheet"
    href="/style.css"
  >

  <style>

    .dashboard-page {
      width: 92%;
      max-width: 1050px;
      margin: 0 auto;
      padding: 30px 0 60px;
    }


    .dashboard-hero {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;

      margin-bottom: 24px;
      padding: 28px;

      border:
        1px solid
        rgba(255,255,255,.08);

      border-radius: 24px;

      background:
        linear-gradient(
          135deg,
          rgba(99,102,241,.16),
          rgba(139,92,246,.08)
        );

      box-shadow:
        0 22px 55px
        rgba(0,0,0,.28);
    }


    .dashboard-hero h1 {
      margin: 8px 0 9px;
      font-size: 31px;
    }


    .dashboard-hero p {
      margin: 0;
      color: #94a3b8;
    }


    .hero-progress {
      width: 92px;
      height: 92px;

      display: flex;
      align-items: center;
      justify-content: center;
      flex-direction: column;

      flex-shrink: 0;

      border-radius: 50%;

      background:
        rgba(99,102,241,.14);

      border:
        1px solid
        rgba(99,102,241,.25);
    }


    .hero-progress strong {
      color: #fff;
      font-size: 23px;
    }


    .hero-progress span {
      margin-top: 4px;
      color: #c7d2fe;
      font-size: 11px;
    }


    .dashboard-stats {
      display: grid;

      grid-template-columns:
        repeat(4, minmax(0,1fr));

      gap: 15px;
      margin-bottom: 22px;
    }


    .dashboard-stat {
      min-height: 115px;

      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;

      gap: 7px;
      padding: 17px;

      text-align: center;

      border:
        1px solid
        rgba(255,255,255,.08);

      border-radius: 18px;

      background:
        rgba(24,34,53,.86);

      box-shadow:
        0 15px 35px
        rgba(0,0,0,.22);
    }


    .dashboard-stat strong {
      color: #fff;
      font-size: 27px;
      line-height: 1.3;
    }


    .dashboard-stat span {
      color: #cbd5e1;
      font-size: 13px;
      font-weight: 700;
    }


    .continue-section {
      margin-bottom: 22px;
      padding: 24px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 20px;

      border:
        1px solid
        rgba(99,102,241,.28);

      border-radius: 22px;

      background:
        linear-gradient(
          135deg,
          rgba(99,102,241,.18),
          rgba(139,92,246,.09)
        );

      box-shadow:
        0 18px 45px
        rgba(0,0,0,.25);
    }


    .continue-information {
      display: flex;
      align-items: center;
      gap: 15px;
    }


    .continue-icon {
      width: 54px;
      height: 54px;

      display: flex;
      align-items: center;
      justify-content: center;

      flex-shrink: 0;

      border-radius: 16px;

      background:
        linear-gradient(
          135deg,
          #6366f1,
          #8b5cf6
        );

      color: white;
      font-size: 23px;

      box-shadow:
        0 12px 30px
        rgba(99,102,241,.3);
    }


    .continue-information h2 {
      margin: 0 0 7px;
      font-size: 20px;
    }


    .continue-information p {
      margin: 0;
      color: #94a3b8;
      line-height: 1.7;
    }


    .continue-information strong {
      color: #fff;
    }


    .continue-button {
      min-width: 210px;
      min-height: 51px;

      display: inline-flex;
      align-items: center;
      justify-content: center;

      padding: 11px 18px;

      border-radius: 15px;

      background:
        linear-gradient(
          135deg,
          #6366f1,
          #8b5cf6
        );

      color: white;

      font-size: 14px;
      font-weight: 900;

      box-shadow:
        0 13px 32px
        rgba(99,102,241,.32);

      transition:
        transform .2s,
        box-shadow .2s;
    }


    .continue-button:hover {
      transform: translateY(-2px);

      box-shadow:
        0 18px 40px
        rgba(99,102,241,.42);
    }


    .all-completed-section {
      margin-bottom: 22px;
      padding: 24px;

      border:
        1px solid
        rgba(34,197,94,.27);

      border-radius: 22px;

      background:
        rgba(34,197,94,.09);

      text-align: center;
    }


    .all-completed-section h2 {
      margin: 0 0 8px;
      color: #dcfce7;
    }


    .all-completed-section p {
      margin: 0;
      color: #bbf7d0;
    }


    .dashboard-panel {
      margin-bottom: 22px;
      padding: 24px;

      border:
        1px solid
        rgba(255,255,255,.08);

      border-radius: 22px;

      background:
        rgba(24,34,53,.88);

      box-shadow:
        0 20px 48px
        rgba(0,0,0,.26);
    }


    .panel-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 15px;
      margin-bottom: 17px;
    }


    .panel-heading h2 {
      margin: 0;
      font-size: 23px;
    }


    .progress-percent {
      color: #c7d2fe;
      font-size: 16px;
      font-weight: 900;
    }


    .dashboard-progress-track {
      width: 100%;
      height: 12px;

      margin: 16px 0;
      overflow: hidden;

      border-radius: 999px;
      background: #020617;
    }


    .dashboard-progress-fill {
      height: 100%;

      border-radius: 999px;

      background:
        linear-gradient(
          90deg,
          #6366f1,
          #a855f7
        );
    }


    .progress-description {
      margin: 0;
      color: #94a3b8;
      line-height: 1.8;
    }


    .chapters-list {
      display: grid;
      gap: 18px;
    }


    .chapter-item {
      overflow: hidden;

      border:
        1px solid
        rgba(255,255,255,.08);

      border-radius: 19px;

      background:
        rgba(15,23,42,.72);
    }


    .chapter-item > summary {
      list-style: none;

      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 15px;
      padding: 20px;

      cursor: pointer;

      background:
        rgba(99,102,241,.09);

      transition:
        background .2s;
    }


    .chapter-item > summary::-webkit-details-marker {
      display: none;
    }


    .chapter-item > summary:hover {
      background:
        rgba(99,102,241,.15);
    }


    .chapter-item[open] > summary {
      border-bottom:
        1px solid
        rgba(255,255,255,.08);
    }


    .chapter-title-area {
      display: flex;
      align-items: center;
      gap: 12px;
    }


    .chapter-icon {
      width: 43px;
      height: 43px;

      display: flex;
      align-items: center;
      justify-content: center;

      flex-shrink: 0;

      border-radius: 13px;

      background:
        linear-gradient(
          135deg,
          #6366f1,
          #8b5cf6
        );

      font-size: 20px;
    }


    .chapter-title-area h3 {
      margin: 0 0 5px;
      font-size: 19px;
    }


    .chapter-info {
      color: #94a3b8;
      font-size: 13px;
    }


    .chapter-arrow {
      color: #a5b4fc;
      font-size: 18px;
    }


    .lessons-box {
      display: grid;
      gap: 14px;
      padding: 17px;
    }


    .lesson-card {
      display: grid;

      grid-template-columns:
        auto
        minmax(0,1fr)
        auto;

      align-items: center;

      gap: 15px;
      padding: 17px;

      border:
        1px solid
        rgba(255,255,255,.08);

      border-radius: 17px;

      background:
        rgba(24,34,53,.72);
    }


    .lesson-card.completed {
      border-color:
        rgba(34,197,94,.27);

      background:
        rgba(34,197,94,.07);
    }


    .lesson-card.available {
      border-color:
        rgba(99,102,241,.27);
    }


    .lesson-card.locked {
      opacity: .62;

      background:
        rgba(15,23,42,.56);

      cursor: not-allowed;
    }


    .lesson-status-icon {
      width: 43px;
      height: 43px;

      display: flex;
      align-items: center;
      justify-content: center;

      flex-shrink: 0;

      border-radius: 13px;

      font-size: 18px;
      font-weight: 900;
    }


    .lesson-card.completed .lesson-status-icon {
      background:
        rgba(34,197,94,.18);

      color: #bbf7d0;
    }


    .lesson-card.available .lesson-status-icon {
      background:
        rgba(99,102,241,.18);

      color: #c7d2fe;
    }


    .lesson-card.locked .lesson-status-icon {
      background:
        rgba(148,163,184,.12);

      color: #cbd5e1;
    }


    .lesson-information {
      min-width: 0;
    }


    .lesson-information h4 {
      margin: 0 0 6px;

      color: #fff;

      font-size: 17px;
      line-height: 1.6;
    }


    .lesson-information p {
      margin: 0;

      color: #94a3b8;

      font-size: 13px;
      line-height: 1.7;
    }


    .lesson-actions {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      flex-wrap: wrap;

      gap: 9px;
    }


    .lesson-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;

      min-height: 33px;

      padding: 7px 11px;

      border-radius: 999px;

      font-size: 12px;
      font-weight: 900;

      white-space: nowrap;
    }


    .lesson-badge.completed {
      color: #bbf7d0;

      background:
        rgba(34,197,94,.14);

      border:
        1px solid
        rgba(34,197,94,.22);
    }


    .lesson-badge.available {
      color: #c7d2fe;

      background:
        rgba(99,102,241,.14);

      border:
        1px solid
        rgba(99,102,241,.22);
    }


    .lesson-badge.locked {
      color: #cbd5e1;

      background:
        rgba(148,163,184,.11);

      border:
        1px solid
        rgba(148,163,184,.18);
    }


    .lesson-open-button {
      min-height: 43px;

      display: inline-flex;
      align-items: center;
      justify-content: center;

      padding: 10px 15px;

      border-radius: 13px;

      background:
        linear-gradient(
          135deg,
          #6366f1,
          #8b5cf6
        );

      color: white;

      font-size: 13px;
      font-weight: 900;

      box-shadow:
        0 10px 27px
        rgba(99,102,241,.24);
    }


    .lesson-card.completed .lesson-open-button {
      background:
        linear-gradient(
          135deg,
          #16a34a,
          #059669
        );

      box-shadow:
        0 10px 27px
        rgba(34,197,94,.2);
    }


    .locked-button {
      min-height: 43px;

      padding: 10px 14px;

      border:
        1px solid
        rgba(148,163,184,.16);

      border-radius: 13px;

      background:
        rgba(148,163,184,.08);

      color: #94a3b8;

      font-size: 12px;
      font-weight: 900;

      cursor: not-allowed;
    }


    .empty-lessons {
      padding: 19px;

      border:
        1px dashed
        rgba(255,255,255,.1);

      border-radius: 14px;

      color: #94a3b8;
      text-align: center;
    }


    @media (max-width: 760px) {

      .dashboard-page {
        width: 94%;
        padding-top: 20px;
      }


      .dashboard-hero {
        flex-direction: column;

        padding: 22px 17px;

        text-align: center;
      }


      .dashboard-hero h1 {
        font-size: 25px;
      }


      .hero-progress {
        width: 82px;
        height: 82px;
      }


      .dashboard-stats {
        grid-template-columns:
          repeat(2, minmax(0,1fr));

        gap: 11px;
      }


      .dashboard-stat {
        min-height: 103px;
        padding: 13px;
      }


      .dashboard-stat strong {
        font-size: 22px;
      }


      .continue-section {
        flex-direction: column;
        align-items: stretch;

        padding: 19px 16px;
      }


      .continue-information {
        align-items: flex-start;
      }


      .continue-button {
        width: 100%;
        min-width: 0;
      }


      .dashboard-panel {
        padding: 18px 14px;
      }


      .chapter-item > summary {
        padding: 16px;
      }


      .chapter-title-area {
        align-items: flex-start;
      }


      .lessons-box {
        padding: 12px;
      }


      .lesson-card {
        grid-template-columns:
          auto
          minmax(0,1fr);

        align-items: flex-start;

        padding: 14px;
      }


      .lesson-actions {
        grid-column: 1 / -1;

        flex-direction: column;
        align-items: stretch;
      }


      .lesson-badge,
      .lesson-open-button,
      .locked-button {
        width: 100%;
        text-align: center;
      }

    }


    @media (max-width: 420px) {

      .dashboard-stats {
        grid-template-columns: 1fr;
      }


      .dashboard-stat {
        min-height: 88px;
      }


      .chapter-title-area h3 {
        font-size: 16px;
      }

    }

  </style>


  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#0d6efd">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="Rabie Physics">
  <link rel="apple-touch-icon" href="/icons/icon-192.png">

</head>


<body>


<%
  const dashboardContinueLesson =
    typeof continueLesson !== "undefined"
      ? continueLesson
      : null;

  const dashboardAllCompleted =
    typeof allLessonsCompleted !== "undefined"
      ? allLessonsCompleted
      : (
          totalLessons > 0 &&
          completedCount === totalLessons
        );
%>


<nav class="topbar">

  <a
    class="logo"
    href="/dashboard"
  >
    <span>⚛</span>
    physics
  </a>


  <div class="nav-actions">

    <span class="user-pill">
      👤 <%= user.username %>
    </span>


    <form
      method="POST"
      action="/logout"
    >
      <button
        class="btn ghost small"
        type="submit"
      >
        خروج
      </button>
    </form>

  </div>

</nav>


<main class="dashboard-page">


  <section class="dashboard-hero">

    <div>

      <span class="eyebrow">
        لوحة الطالب
      </span>


      <h1>
        أهلاً يا <%= user.username %> 👋
      </h1>


      <p>
        <%= user.grade === "second"
          ? "الصف الثاني الثانوي"
          : "الصف الثالث الثانوي"
        %>
      </p>

    </div>


    <div class="hero-progress">

      <strong>
        <%= progressPercent %>%
      </strong>

      <span>
        نسبة الإنجاز
      </span>

    </div>

  </section>


  <section class="dashboard-stats">

    <div class="dashboard-stat">

      <strong>
        <%= chapters.length %>
      </strong>

      <span>
        📚 الفصول
      </span>

    </div>


    <div class="dashboard-stat">

      <strong>
        <%= totalLessons %>
      </strong>

      <span>
        🎬 الدروس
      </span>

    </div>


    <div class="dashboard-stat">

      <strong>
        <%= completedCount %>
      </strong>

      <span>
        ✅ مكتملة
      </span>

    </div>


    <div class="dashboard-stat">

      <strong>
        <%= student.subscriptionExpiry
          ? new Date(
              student.subscriptionExpiry
            ).toLocaleDateString("ar-EG")
          : "-"
        %>
      </strong>

      <span>
        📅 انتهاء الاشتراك
      </span>

    </div>

  </section>


  <% if(dashboardAllCompleted){ %>

    <section class="all-completed-section">

      <h2>
        🎉 أحسنت! أنهيت جميع الدروس
      </h2>

      <p>
        يمكنك الرجوع لأي درس مكتمل ومشاهدته مرة أخرى.
      </p>

    </section>

  <% } else if(dashboardContinueLesson){ %>

    <section class="continue-section">

      <div class="continue-information">

        <div class="continue-icon">
          ▶
        </div>


        <div>

          <h2>
            كمّل من آخر مكان وصلت له
          </h2>


          <p>

            <strong>
              <%= dashboardContinueLesson.title %>
            </strong>

            <% if(dashboardContinueLesson.chapterTitle){ %>

              —

              <%= dashboardContinueLesson.chapterTitle %>

            <% } %>

          </p>

        </div>

      </div>


      <a
        class="continue-button"
        href="/lesson/<%= user.grade %>/<%= dashboardContinueLesson.id %>"
      >
        متابعة الدرس ←
      </a>

    </section>

  <% } %>


  <section class="dashboard-panel">

    <div class="panel-heading">

      <h2>
        المسار الدراسي
      </h2>

      <span class="progress-percent">
        <%= progressPercent %>%
      </span>

    </div>


    <div class="dashboard-progress-track">

      <div
        class="dashboard-progress-fill"
        style="width:<%= progressPercent %>%"
      ></div>

    </div>


    <p class="progress-description">

      أنهيت

      <strong>
        <%= completedCount %>
      </strong>

      من

      <strong>
        <%= totalLessons %>
      </strong>

      درس.

    </p>

  </section>


  <section class="dashboard-panel">

    <div class="panel-heading">

      <h2>
        📚 محتوى الصف
      </h2>

    </div>


    <div class="chapters-list">


      <% chapters.forEach((chapter, chapterIndex) => {

        const chapterLessons =
          lessons.filter(
            lesson =>
              String(lesson.chapterId) ===
              String(chapter.id)
          );

        const completedInChapter =
          chapterLessons.filter(
            lesson =>
              lesson.completed
          ).length;

      %>


        <details
          class="chapter-item"
          <%= chapterIndex === 0 ? "open" : "" %>
        >


          <summary>

            <div class="chapter-title-area">

              <span class="chapter-icon">
                ⚡
              </span>


              <div>

                <h3>
                  <%= chapter.title %>
                </h3>


                <span class="chapter-info">

                  <%= completedInChapter %>

                  من

                  <%= chapterLessons.length %>

                  درس مكتمل

                </span>

              </div>

            </div>


            <span class="chapter-arrow">
              ▼
            </span>

          </summary>


          <div class="lessons-box">


            <% if(!chapterLessons.length){ %>

              <div class="empty-lessons">
                لا توجد دروس داخل هذا الفصل حتى الآن.
              </div>

            <% } %>


            <% chapterLessons.forEach(lesson => {

              const isCompleted =
                Boolean(lesson.completed);

              const isUnlocked =
                Boolean(lesson.unlocked);

              const isLocked =
                !isCompleted &&
                !isUnlocked;

            %>


              <article
                class="
                  lesson-card
                  <%= isCompleted
                    ? "completed"
                    : isLocked
                      ? "locked"
                      : "available"
                  %>
                "
              >


                <div class="lesson-status-icon">

                  <% if(isCompleted){ %>

                    ✅

                  <% } else if(isLocked){ %>

                    🔒

                  <% } else { %>

                    📘

                  <% } %>

                </div>


                <div class="lesson-information">

                  <h4>
                    <%= lesson.title %>
                  </h4>


                  <p>
                    <%= lesson.description || "درس فيزياء" %>
                  </p>

                </div>


                <div class="lesson-actions">


                  <% if(isCompleted){ %>

                    <span class="lesson-badge completed">
                      ✅ مكتمل
                    </span>


                    <a
                      class="lesson-open-button"
                      href="/lesson/<%= user.grade %>/<%= lesson.id %>"
                    >
                      مشاهدة الدرس مرة أخرى
                    </a>


                  <% } else if(isUnlocked){ %>

                    <span class="lesson-badge available">
                      📘 متاح الآن
                    </span>


                    <a
                      class="lesson-open-button"
                      href="/lesson/<%= user.grade %>/<%= lesson.id %>"
                    >
                      فتح الدرس
                    </a>


                  <% } else { %>

                    <span class="lesson-badge locked">
                      🔒 غير متاح
                    </span>


                    <button
                      class="locked-button"
                      type="button"
                      disabled
                    >
                      يجب إنهاء جميع الدروس السابقة
                    </button>


                  <% } %>


                </div>

              </article>


            <% }) %>


          </div>

        </details>


      <% }) %>


    </div>

  </section>


</main>



  <script>
    if ("serviceWorker" in navigator) {
      window.addEventListener("load", function () {
        navigator.serviceWorker
          .register("/service-worker.js")
          .then(function (registration) {
            console.log("Service Worker registered:", registration.scope);
          })
          .catch(function (error) {
            console.error("Service Worker registration failed:", error);
          });
      });
    }
  </script>

</body>

</html>
