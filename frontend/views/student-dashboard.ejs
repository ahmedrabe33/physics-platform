<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>لوحة الطالب</title><link rel="stylesheet" href="/style.css"></head><body>
<nav class="topbar"><a class="logo" href="/dashboard"><span>⚛</span> physics</a><div class="nav-actions"><span class="user-pill">👤 <%= user.username %></span><form method="POST" action="/logout"><button class="btn ghost small">خروج</button></form></div></nav>
<main class="container"><section class="hero"><div><span class="eyebrow">لوحة الطالب</span><h1>أهلاً يا <%= user.username %> 👋</h1><p><%= user.grade==="second"?"الصف الثاني الثانوي":"الصف الثالث الثانوي" %></p></div><div class="hero-stat"><strong><%= progressPercent %>%</strong><span>نسبة الإنجاز</span></div></section>
<section class="stats-grid"><div class="stat-card"><div class="stat-icon">📚</div><div><strong><%= chapters.length %></strong><span>الفصول</span></div></div><div class="stat-card"><div class="stat-icon">🎬</div><div><strong><%= totalLessons %></strong><span>إجمالي الدروس</span></div></div><div class="stat-card"><div class="stat-icon">✅</div><div><strong><%= completedCount %></strong><span>دروس مكتملة</span></div></div><div class="stat-card"><div class="stat-icon">📅</div><div><strong><%= student.subscriptionExpiry?new Date(student.subscriptionExpiry).toLocaleDateString("ar-EG"):"-" %></strong><span>انتهاء الاشتراك</span></div></div></section>
<section class="panel"><div class="section-head"><div><span class="eyebrow">تقدمك</span><h2>المسار الدراسي</h2></div><span class="percent"><%= progressPercent %>%</span></div><div class="progress-track"><div class="progress-fill" style="width:<%= progressPercent %>%"></div></div><p class="muted">أنهيت <strong><%= completedCount %></strong> من <strong><%= totalLessons %></strong> درس.</p><a class="btn primary" href="/grade/<%= user.grade %>">متابعة الدروس ←</a></section>
<section class="panel"><div class="section-head"><div><span class="eyebrow">الفصول</span><h2>محتوى الصف</h2></div></div><div class="chapter-grid"><% chapters.forEach(chapter=>{ const cl=lessons.filter(l=>String(l.chapterId)===String(chapter.id)); const cc=cl.filter(l=>l.completed).length; %><article class="course-card"><div class="course-icon">⚡</div><h3><%= chapter.title %></h3><p><%= cl.length %> درس</p><div class="mini-progress"><div style="width:<%= cl.length?Math.round((cc/cl.length)*100):0 %>%"></div></div><span class="muted"><%= cc %> / <%= cl.length %> مكتمل</span></article><% }) %></div></section></main>
</body></html>
