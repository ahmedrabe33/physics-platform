<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>لوحة المدرس</title><link rel="stylesheet" href="/style.css"></head><body><nav class="topbar"><a class="logo" href="/admin"><span>⚛</span> physics Admin</a><div class="nav-actions"><a href="/admin/content">📚 إدارة المحتوى</a><form method="POST" action="/logout"><button class="btn ghost small">خروج</button></form></div></nav><main class="container"><header class="page-head"><div><span class="eyebrow">لوحة المدرس</span><h1>أهلاً يا <%= user.username %> 👋</h1><p class="muted">تابع الطلاب والمحتوى من مكان واحد.</p></div><a class="btn primary" href="/admin/content">إدارة المحتوى</a></header><section class="stats-grid admin-stats"><div class="stat-card"><div class="stat-icon">👥</div><div><strong><%= stats.totalStudents %></strong><span>الطلاب</span></div></div><div class="stat-card"><div class="stat-icon">⏳</div><div><strong><%= stats.pendingStudents %></strong><span>بانتظار الموافقة</span></div></div><div class="stat-card"><div class="stat-icon">✅</div><div><strong><%= stats.approvedStudents %></strong><span>فعال</span></div></div><div class="stat-card"><div class="stat-icon">📚</div><div><strong><%= stats.chaptersCount %></strong><span>الفصول</span></div></div><div class="stat-card"><div class="stat-icon">🎬</div><div><strong><%= stats.lessonsCount %></strong><span>الدروس</span></div></div></section><section class="panel"><div class="section-head"><div><span class="eyebrow">الاشتراكات</span><h2>الطلاب</h2></div></div><div class="students-grid"><% students.forEach(student=>{ %><article class="student-card"><div class="student-top"><div class="avatar"><%= student.username.charAt(0).toUpperCase() %></div><div><h3><%= student.username %></h3><p><%= student.email %></p></div><span class="badge <%= student.status %>"><%= student.status %></span></div><div class="student-meta"><span>🎓 <%= student.grade==="second"?"الثاني الثانوي":"الثالث الثانوي" %></span><span>🗓 <%= new Date(student.registeredAt).toLocaleDateString("ar-EG") %></span><% if(student.subscriptionExpiry){ %><span>⏰ <%= new Date(student.subscriptionExpiry).toLocaleDateString("ar-EG") %></span><% } %></div><% if(student.paymentProof){ %><a class="proof-link" href="http://localhost:3002<%= student.paymentProof %>" target="_blank">🧾 عرض إثبات الدفع</a><% } %><div class="card-actions"><% if(student.status==="pending"){ %><form method="POST" action="/admin/approve/<%= student.userId %>"><button class="btn success-btn small">✓ موافقة</button></form><form method="POST" action="/admin/reject/<%= student.userId %>"><button class="btn danger small">رفض</button></form><% } else { %><form method="POST" action="/admin/renew/<%= student.userId %>"><button class="btn primary small">↻ تجديد شهر</button></form><% } %></div></article><% }) %></div></section></main></body></html>
