<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>إدارة المحتوى</title><link rel="stylesheet" href="/style.css"></head><body><nav class="topbar"><a class="logo" href="/admin"><span>⚛</span> physics Admin</a><div class="nav-actions"><a href="/admin">👥 الطلاب</a><form method="POST" action="/logout"><button class="btn ghost small">خروج</button></form></div></nav><main class="container"><header class="page-head"><div><span class="eyebrow">Content Management</span><h1>إدارة المحتوى</h1><p class="muted">إضافة وتعديل وحذف الفصول والدروس والتدريبات بدون IDs.</p></div></header><section class="panel"><div class="section-head"><div><span class="eyebrow">إضافة جديد</span><h2>فصل دراسي</h2></div></div><form class="inline-form" method="POST" action="/admin/content/chapter"><select name="grade"><option value="second">الصف الثاني الثانوي</option><option value="third">الصف الثالث الثانوي</option></select><input name="title" placeholder="اسم الفصل" required><button class="btn primary">+ إضافة الفصل</button></form></section><% ["second","third"].forEach(grade=>{ %><section class="grade-admin"><div class="grade-title"><div class="grade-icon">🎓</div><div><span class="eyebrow">Grade</span><h2><%= grade==="second"?"الصف الثاني الثانوي":"الصف الثالث الثانوي" %></h2></div></div><% content[grade].chapters.forEach(chapter=>{ %><article class="panel chapter-admin"><div class="admin-title-row"><div><span class="eyebrow">الفصل <%= chapter.order %></span><h2><%= chapter.title %></h2></div><form method="POST" action="/admin/content/chapter/<%= grade %>/<%= chapter.id %>/delete" onsubmit="return confirm('حذف الفصل بكل محتواه؟')"><button class="btn danger small">🗑 حذف</button></form></div><details class="edit-box"><summary>✏️ تعديل اسم الفصل</summary><form class="inline-form" method="POST" action="/admin/content/chapter/<%= grade %>/<%= chapter.id %>/edit"><input name="title" value="<%= chapter.title %>" required><button class="btn secondary">حفظ</button></form></details><div class="subsection"><h3>+ إضافة درس</h3><form method="POST" action="/admin/content/lesson"><input type="hidden" name="grade" value="<%= grade %>"><input type="hidden" name="chapterId" value="<%= chapter.id %>"><input name="title" placeholder="اسم الدرس" required><textarea name="description" placeholder="وصف الدرس"></textarea><input name="videoUrl" placeholder="رابط الفيديو"><button class="btn primary">إضافة الدرس</button></form></div><% chapter.lessons.forEach(lesson=>{ %><div class="lesson-admin"><div class="admin-title-row"><div><span class="lesson-index"><%= lesson.order %></span><strong><%= lesson.title %></strong></div><form method="POST" action="/admin/content/lesson/<%= grade %>/<%= lesson.id %>/delete" onsubmit="return confirm('حذف الدرس؟')"><button class="btn danger small">حذف</button></form></div><details class="edit-box"><summary>✏️ تعديل الدرس</summary><form method="POST" action="/admin/content/lesson/<%= grade %>/<%= lesson.id %>/edit"><input name="title" value="<%= lesson.title %>" required><textarea name="description"><%= lesson.description %></textarea><input name="videoUrl" value="<%= lesson.videoUrl %>"><button class="btn secondary">حفظ</button></form></details><div class="exercise-admin-list"><h4>التدريبات</h4><% lesson.exercises.forEach(ex=>{ %><div class="exercise-admin-card"><strong>س<%= ex.order %>. <%= ex.question %></strong><p>الإجابة: <span class="answer-chip"><%= ex.correctAnswer %></span></p><details class="edit-box"><summary>تعديل</summary><form method="POST" action="/admin/content/exercise/<%= grade %>/<%= lesson.id %>/<%= ex.id %>/edit"><textarea name="question" required><%= ex.question %></textarea><input name="correctAnswer" value="<%= ex.correctAnswer %>" required><button class="btn secondary small">حفظ</button></form></details><form method="POST" action="/admin/content/exercise/<%= grade %>/<%= lesson.id %>/<%= ex.id %>/delete" onsubmit="return confirm('حذف السؤال؟')"><button class="btn danger small">حذف السؤال</button></form></div><% }) %><form class="exercise-add" method="POST" action="/admin/content/exercise"><input type="hidden" name="grade" value="<%= grade %>"><input type="hidden" name="lessonId" value="<%= lesson.id %>"><textarea name="question" placeholder="سؤال جديد" required></textarea><input name="correctAnswer" placeholder="الإجابة الصحيحة" required><button class="btn primary">+ إضافة تدريب</button></form></div></div><% }) %></article><% }) %></section><% }) %></main></body></html>
